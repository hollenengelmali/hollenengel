---
import type { CollectionEntry } from 'astro:content';
import { useT, type Lang } from '../i18n/ui';
import { PLACEHOLDER, formatMonth } from '../lib/content';

interface Props {
  dog: CollectionEntry<'dogs'>;
  lang: Lang;
}
const { dog, lang } = Astro.props;
const t = useT(lang);
const d = dog.data;
---

<a
  href={`/${lang}/dogs/${dog.id}/`}
  class="group card relative block overflow-hidden transition hover:border-blood"
  data-sex={d.sex}
  data-status={d.status}
>
  <div class="relative aspect-[4/5] overflow-hidden">
    <img
      src={d.photo || PLACEHOLDER}
      alt={d.name}
      loading="lazy"
      class="h-full w-full object-cover transition duration-500 group-hover:scale-105"
    />
    <div class="absolute inset-0 bg-gradient-to-t from-ink via-ink/20 to-transparent"></div>
    <span class="absolute left-3 top-3 bg-ink/80 px-3 py-1 font-display text-xs uppercase tracking-widest">
      {d.sex === 'male' ? t('sex_male') : t('sex_female')}
    </span>
    {
      d.status !== 'active' && (
        <span class="absolute right-3 top-3 bg-gold px-3 py-1 font-display text-xs uppercase tracking-widest text-ink">
          {d.status === 'retired' ? t('status_retired') : t('status_memorial')}
        </span>
      )
    }
    <div
      class="absolute inset-x-0 bottom-0 translate-y-6 space-y-1 p-4 opacity-100 transition duration-300 group-hover:translate-y-0"
    >
      <h3 class="text-2xl">{d.name}</h3>
      {d.birth_date && <p class="text-xs text-bone/70">{t('born')}: {formatMonth(d.birth_date, lang)}</p>}
      <p class="max-h-0 overflow-hidden text-xs text-bone/80 opacity-0 transition-all duration-300 group-hover:max-h-16 group-hover:opacity-100">
        {d.pedigree.sire && d.pedigree.dam ? `${d.pedigree.sire} × ${d.pedigree.dam}` : d.titles.join(' · ')}
      </p>
    </div>
  </div>
</a>
