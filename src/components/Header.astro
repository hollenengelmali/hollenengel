---
import Logo from './Logo.astro';
import { languages, useT, type Lang } from '../i18n/ui';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const current = Astro.url.pathname;
const rest = current.replace(/^\/(ro|en)/, '') || '/';

const links = [
  { href: `/${lang}/dogs/`, label: t('nav_dogs') },
  { href: `/${lang}/litters/`, label: t('nav_litters') },
  { href: `/${lang}/breed/`, label: t('nav_breed') },
  { href: `/${lang}/kennel/`, label: t('nav_kennel') },
  { href: `/${lang}/updates/`, label: t('nav_updates') },
  { href: `/${lang}/gallery/`, label: t('nav_gallery') },
  { href: `/${lang}/contact/`, label: t('nav_contact') },
];
const isActive = (href: string) => current.startsWith(href);
---

<header class="sticky top-0 z-50 border-b border-white/10 bg-ink/90 backdrop-blur">
  <div class="container-x flex h-20 items-center justify-between gap-6">
    <a href={`/${lang}/`} aria-label="HöllenEngel"><Logo /></a>

    <nav class="hidden items-center gap-6 lg:flex" aria-label="Main">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={[
              'font-display text-sm uppercase tracking-widest transition hover:text-blood',
              isActive(l.href) ? 'text-blood' : 'text-bone/80',
            ]}
          >
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="flex items-center gap-3">
      <div class="flex items-center gap-1 font-display text-xs tracking-widest">
        {
          (Object.keys(languages) as Lang[]).map((code, i) => (
            <>
              {i > 0 && <span class="text-white/30">/</span>}
              <a
                href={`/${code}${rest}`}
                hreflang={code}
                class:list={[code === lang ? 'text-blood' : 'text-bone/60 hover:text-bone']}
              >
                {code.toUpperCase()}
              </a>
            </>
          ))
        }
      </div>
      <button
        id="menu-btn"
        class="grid h-10 w-10 place-items-center border border-white/20 lg:hidden"
        aria-label="Menu"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M3 6h18M3 12h18M3 18h18"></path>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="hidden border-t border-white/10 bg-ink lg:hidden" aria-label="Mobile">
    <div class="container-x flex flex-col py-2">
      {
        links.map((l) => (
          <a href={l.href} class="border-b border-white/5 py-3 font-display uppercase tracking-widest text-bone/85">
            {l.label}
          </a>
        ))
      }
    </div>
  </nav>
</header>

<script>
  const btn = document.getElementById('menu-btn');
  const nav = document.getElementById('mobile-nav');
  btn?.addEventListener('click', () => {
    const open = nav?.classList.toggle('hidden') === false;
    btn.setAttribute('aria-expanded', String(open));
  });
</script>
