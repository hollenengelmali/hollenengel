---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PageHero from '../../components/PageHero.astro';
import breed from '../../content/settings/breed.json';
import { getLangPaths, useT, type Lang } from '../../i18n/ui';
import { loc, md } from '../../lib/content';

export function getStaticPaths() {
  return getLangPaths();
}

const lang = Astro.params.lang as Lang;
const t = useT(lang);
const title = loc(breed, 'title', lang);
---

<BaseLayout lang={lang} title={title}>
  <PageHero eyebrow={t('nav_breed')} title={title} />
  <section class="container-x py-14">
    <div class="grid gap-10 lg:grid-cols-3">
      <div class="prose-kennel lg:col-span-2" set:html={md(loc(breed, 'body', lang))} />
      {breed.image && <img src={breed.image} alt="" class="w-full object-cover" />}
    </div>
  </section>
</BaseLayout>
